#and
:and A, "#"data8 is op=0x5c; data8 & A { local tmp:1 = A & data8; A = tmp; Z = tmp == 0; }
:and saddr, "#"data8 is op=0x5a; saddr; data8 { local tmp:1 = (*[ram]:1 saddr) & data8; *[ram]:1 saddr = tmp; Z = tmp == 0; }
