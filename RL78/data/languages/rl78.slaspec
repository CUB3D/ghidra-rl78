:sub A, addr16_abs is op=0x2F; addr16_abs & A { local tmp:1; sub_flags(tmp, A, *[ram]:1 addr16_abs); A = tmp; }
:sub A, hl_ind is op=0x2D & hl_ind & A { local tmp:1; sub_flags(tmp, A, *[ram]:1 hl_ind); A = tmp; }
:sub A, addr8_hl_rel is op=0x2E & addr8_hl_rel & A { local tmp:1; sub_flags(tmp, A, *[ram]:1 addr8_hl_rel); A = tmp; }
:sub A, hl_b_ind is op=0x61; op=0xa0 & hl_b_ind & A { local tmp:1; sub_flags(tmp, A, *[ram]:1 hl_b_ind); A = tmp; }
:sub A, hl_c_ind is op=0x61; op=0xa2 & hl_c_ind & A { local tmp:1; sub_flags(tmp, A, *[ram]:1 hl_c_ind); A = tmp; }
:sub A, es_addr16_abs is op=0x11; op=0x2F; es_addr16_abs & A { local tmp:1; sub_flags(tmp, A, *[ram]:1 es_addr16_abs); A = tmp; }
:sub A, es_hl_ind is op=0x11; op=0x2D & es_hl_ind & A { local tmp:1; sub_flags(tmp, A, *[ram]:1 es_hl_ind); A = tmp; }
:sub A, es_addr8_hl_rel is op=0x11; op=0x2E ; es_addr8_hl_rel & A { local tmp:1; sub_flags(tmp, A, *[ram]:1 es_addr8_hl_rel); A = tmp; }
:sub A, es_hl_b_ind is op=0x11; op=0x61; op=0xa0 & es_hl_b_ind & A { local tmp:1; sub_flags(tmp, A, *[ram]:1 es_hl_b_ind); A = tmp; }
:sub A, es_hl_c_ind is op=0x11; op=0x61; op=0xa2 & es_hl_c_ind & A { local tmp:1; sub_flags(tmp, A, *[ram]:1 es_hl_c_ind); A = tmp; }

#subc
macro subc_flags(out, src, dest) {
	local tmp:1 = src - dest;
	out = tmp - CY;
	Z = out == 0;
	AC = (dest & 0b1111) + CY > (src & 0b1111);
	CY = src < dest || tmp < CY;
}
:subc A, "#"data8 is op=0x3c; data8 & A { local tmp:1; subc_flags(tmp, A, data8); A = tmp; }
:subc saddr, "#"data8 is op=0x3a; saddr; data8 { local tmp:1; subc_flags(tmp, *[ram]:1 saddr, data8); *[ram]:1 saddr = tmp; }
