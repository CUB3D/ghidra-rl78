:and A, addr16_abs is op=0x5F; addr16_abs & A { local tmp:1 = A & (*[ram]:1 addr16_abs); A = tmp; Z = tmp == 0; }
:and A, hl_ind is op=0x5D & hl_ind & A { local tmp:1 = A & (*[ram]:1 hl_ind); A = tmp; Z = tmp == 0; }
:and A, addr8_hl_rel is op=0x5E & addr8_hl_rel & A { local tmp:1 = A & (*[ram]:1 addr8_hl_rel); A = tmp; Z = tmp == 0; }
:and A, hl_b_ind is op=0x61; op=0xD0 & hl_b_ind & A { local tmp:1 = A & (*[ram]:1 hl_b_ind); A = tmp; Z = tmp == 0; }
:and A, hl_c_ind is op=0x61; op=0xD2 & hl_c_ind & A { local tmp:1 = A & (*[ram]:1 hl_c_ind); A = tmp; Z = tmp == 0; }
:and A, es_addr16_abs is op=0x11; op=0x5F; es_addr16_abs & A { local tmp:1 = A & (*[ram]:1 es_addr16_abs); A = tmp; Z = tmp == 0; }
:and A, es_hl_ind is op=0x11; op=0x5D & es_hl_ind & A { local tmp:1 = A & (*[ram]:1 es_hl_ind); A = tmp; Z = tmp == 0; }
:and A, es_addr8_hl_rel is op=0x11; op=0x5E ; es_addr8_hl_rel & A { local tmp:1 = A & (*[ram]:1 es_addr8_hl_rel); A = tmp; Z = tmp == 0; }
:and A, es_hl_b_ind is op=0x11; op=0x61; op=0xD0 & es_hl_b_ind & A { local tmp:1 = A & (*[ram]:1 es_hl_b_ind); A = tmp; Z = tmp == 0; }
:and A, es_hl_c_ind is op=0x11; op=0x61; op=0xD2 & es_hl_c_ind & A { local tmp:1 = A & (*[ram]:1 es_hl_c_ind); A = tmp; Z = tmp == 0; }



