# sleigh specification file for Renesas RL78
# This models a RL78-S3 but should work for RL78-S1 and RL78-S2 cores as S3 is a true superset

define endian=little;
define alignment=1;

define space ram     type=ram_space      size=3  default;

define space io      type=ram_space      size=2;
define space register type=register_space size=1;

define ram offset=0xFFEE0 size=1 [
	RB3_X RB3_A RB3_C RB3_B
	RB3_E RB3_D RB3_L RB3_H
	
	RB2_X RB2_A RB2_C RB2_B
	RB2_E RB2_D RB2_L RB2_H
	
	RB1_X RB1_A RB1_C RB1_B
	RB1_E RB1_D RB1_L RB1_H
	
	RB0_X RB0_A RB0_C RB0_B
	RB0_E RB0_D RB0_L RB0_H
];

define ram offset=0xFFEE0 size=2 [
	RB3_AX RB3_BC
	RB3_DE RB3_HL
	
	RB2_AX RB2_BC
	RB2_DE RB2_HL
	
	RB1_AX RB1_BC
	RB1_DE RB1_HL
	
	RB0_AX RB0_BC
	RB0_DE RB0_HL
];

define ram offset=0xFFEE0 size=4 [
	RB3_BCAX
	RB3_HLDE
	
	RB2_BCAX
	RB2_HLDE
	
	RB1_BCAX
	RB1_HLDE
	
	RB0_BCAX
	RB0_HLDE
];


define ram offset=0xFFFF8 size=2 [
	SP
];


define ram offset=0xFFFF8 size=1 [
	SPL
	SPH
	PSW
	Reserve
	CS
	ES
	PMC
	MEM
];


define ram offset=0x0FFF0 size=2 [
	MACRL
	MACRH
];

define ram offset=0x0FFF0 size=4 [
	MACR
];

define register offset=0x0 size=4 contextreg;

define context contextreg
  current_bank		= (0,7)
;

BCAX: "BCAX" is current_bank { local tmp:3 = 0xFFEF8 - current_bank*8; export *:4 tmp; }
HLDE: "HLDE" is current_bank { local tmp:3 = 0xFFEFC - current_bank*8; export *:4 tmp; }


AX2: "AX" is current_bank { local tmp:3 = 0xFFEF8 - current_bank*8; export *:2 tmp;}
AX: "AX" is current_bank { local tmp:3 = 0xFFEF8 - current_bank*8; export *:2 tmp;}
BC: "BC" is current_bank { local tmp:3 = 0xFFEFA - current_bank*8; export *:2 tmp;}
DE: "DE" is current_bank { local tmp:3 = 0xFFEFC - current_bank*8; export *:2 tmp;}
HL: "HL" is current_bank { local tmp:3 = 0xFFEFE - current_bank*8; export *:2 tmp;}

#H: "H" is current_bank { local tmp:3 = 0xFFEFF - current_bank*8; export *:1 tmp;}
#L: "L" is current_bank { local tmp:3 = 0xFFEFE - current_bank*8; export *:1 tmp;}
#D: "D" is current_bank { local tmp:3 = 0xFFEFD - current_bank*8; export *:1 tmp;}
#E: "E" is current_bank { local tmp:3 = 0xFFEFC - current_bank*8; export *:1 tmp;}
B: "B" is current_bank { local tmp:3 = 0xFFEFB - current_bank*8; export *:1 tmp;}
C: "C" is current_bank { local tmp:3 = 0xFFEFA - current_bank*8; export *:1 tmp;}
A: "A" is current_bank { local tmp:3 = 0xFFEF9 - current_bank*8; export *:1 tmp;}
X: "X" is current_bank { local tmp:3 = 0xFFEF8 - current_bank*8; export *:1 tmp;}



define bitrange CY=PSW[0,1]
                ISP0=PSW[1,1]
                ISP1=PSW[2,1]
                RBS0=PSW[3,1]
                AC=PSW[4,1]
                RESB1=PSW[5,1]
                Z=PSW[6,1]
                IE=PSW[7,1] 
;




define token opbyte (8)
	op=(0, 7)
	oplo=(0, 3)
	ophi=(4, 7)
	
	jimm8 = (0, 7) signed
	
	data8 = (0, 7)
	data0_1 = (0, 1)
	
	data3 = (0, 2)
	datal=(0, 7)
	datah=(0, 7)
	datas=(0, 7)
	immlo=(0, 3)
	immhi=(4, 7)
	imm7=(7,7)
	imm4_6 = (4,6)
	imm3_3 = (3, 3)
;

macro pop8(o) {
	local spaddr:3 = zext(SP);
	o = *[ram]:1 spaddr;
	SP = SP + 1;
}

macro push16(v) {
	SP = SP - 2;
	local spaddr:3 = zext(SP);
	*[ram]:2 spaddr = v;
}

macro pop16(o) {
	local spaddr:3 = zext(SP);
	o = *[ram]:2 spaddr;
	SP = SP + 2;
}

macro push32(v) {
	SP = SP - 4;
	local spaddr:3 = zext(SP);
	*[ram]:4 spaddr = v;
}

macro pop32(o) {
	local spaddr:3 = zext(SP);
	o = *[ram]:4 spaddr;
	SP = SP + 4;
}

macro pop24(o) {
	local spaddr:3 = zext(SP);
	o = *[ram]:3 spaddr;
	SP = SP + 3;
}

reg8_xacbedlh: is data3 & imm3_3=0 & current_bank {
	local tmp:3 = 0xFFEF8 + (data3 & 0xF) - 8*current_bank;

	export *[ram]:1 tmp;
}






data16: data is datal ; datah [ data = (datah << 8) | datal;] { export *[const]:2 data; }
#data20: data is datal ; datah [ data = (datah << 8) | datal;] { export *[const]:2 data; }

addr16_abs: !val is datal ; datah [val = 0xF0000 | (datah << 8) | datal;] { export *[const]:3 val;}
addr20_abs: !!data20 is datal; datah; datas [ data20 = (datas << 16) | (datah << 8) | datal;] { export *[const]:3 data20; }
addr8_rel: "$" addr8 is jimm8 [addr8 = inst_start + 2 + jimm8; ] { export *[const]:3 addr8;}
addr16_rel: "$!" addr16 is datal ; jimm8 [addr16 = inst_start + 3 + ((jimm8 << 8) | datal);] { export *[const]:3 addr16;}

# short direct addressing
saddr: val is jimm8 [val = 0xffe20 + jimm8;] { export *[const]:3 val; }
saddrp: val is jimm8 & data0_1=0 [val = 0xffe20 + jimm8;] { export *[const]:3 val; }

# SFR addressing
sfr: val is jimm8 [val = 0xfff00 + jimm8;] { export *[const]:3 val; }
sfrp: val is jimm8 & data0_1=0 [val = 0xfff00 + jimm8;] { export *[const]:3 val; }

reg_xcbedlh: is oplo=0x8 & current_bank { local tmp:3=0xFFEF8 - current_bank*8; export *[ram]:1 tmp; }
reg_xcbedlh: is oplo=0xA & current_bank { local tmp:3=0xFFEFA - current_bank*8; export *[ram]:1 tmp; }
reg_xcbedlh: is oplo=0xB & current_bank { local tmp:3=0xFFEFB - current_bank*8; export *[ram]:1 tmp; }
reg_xcbedlh: is oplo=0xC & current_bank { local tmp:3=0xFFEFC - current_bank*8; export *[ram]:1 tmp; }
reg_xcbedlh: is oplo=0xD & current_bank { local tmp:3=0xFFEFD - current_bank*8; export *[ram]:1 tmp; }
reg_xcbedlh: is oplo=0xE & current_bank { local tmp:3=0xFFEFE - current_bank*8; export *[ram]:1 tmp; }
reg_xcbedlh: is oplo=0xF & current_bank { local tmp:3=0xFFEFF - current_bank*8; export *[ram]:1 tmp; }

reg_xcbedlh_low: is oplo=0x0 & current_bank { local tmp:3=0xFFEF8 - current_bank*8; export *[ram]:1 tmp; }
reg_xcbedlh_low: is oplo=0x2 & current_bank { local tmp:3=0xFFEFA - current_bank*8; export *[ram]:1 tmp; }
reg_xcbedlh_low: is oplo=0x3 & current_bank { local tmp:3=0xFFEFB - current_bank*8; export *[ram]:1 tmp; }
reg_xcbedlh_low: is oplo=0x4 & current_bank { local tmp:3=0xFFEFC - current_bank*8; export *[ram]:1 tmp; }
reg_xcbedlh_low: is oplo=0x5 & current_bank { local tmp:3=0xFFEFD - current_bank*8; export *[ram]:1 tmp; }
reg_xcbedlh_low: is oplo=0x6 & current_bank { local tmp:3=0xFFEFE - current_bank*8; export *[ram]:1 tmp; }
reg_xcbedlh_low: is oplo=0x7 & current_bank { local tmp:3=0xFFEFF - current_bank*8; export *[ram]:1 tmp; }

reg_cbedlh: is oplo=0x8 & current_bank { local tmp:1=0xFFEF8 - current_bank*8; export *[ram]:1 tmp; }
reg_cbedlh: is oplo=0xA & current_bank { local tmp:1=0xFFEFA - current_bank*8; export *[ram]:1 tmp; }
reg_cbedlh: is oplo=0xB & current_bank { local tmp:1=0xFFEFB - current_bank*8; export *[ram]:1 tmp; }
reg_cbedlh: is oplo=0xC & current_bank { local tmp:1=0xFFEFC - current_bank*8; export *[ram]:1 tmp; }
reg_cbedlh: is oplo=0xD & current_bank { local tmp:3=0xFFEFD - current_bank*8; export *[ram]:1 tmp; }
reg_cbedlh: is oplo=0xE & current_bank { local tmp:3=0xFFEFE - current_bank*8; export *[ram]:1 tmp; }

hl_ind: [HL] is HL { local addr:3 = zext(HL); local tmp:3 = zext(*[ram]:2 addr); export *[const]:3 tmp;}
de_ind: [DE] is DE { local addr:3 = zext(DE); local tmp:3 = zext(*[ram]:2 addr); export *[const]:3 tmp;}

hl_b_ind: [HL + B] is HL & B { local addr:3 = zext(HL) + zext(B); local tmp:3 = zext(*[ram]:2 addr); export *[const]:3 tmp;}
hl_c_ind: [HL + C] is HL & C { local addr:3 = zext(HL) + zext(C); local tmp:3 = zext(*[ram]:2 addr); export *[const]:3 tmp;}

addr8_hl_rel: [HL + data8] is HL & data8 {
	local addr:3 = zext(HL)+zext(data8:1); 
	local val:3 = zext(*[ram]:2 addr);
	export *[const]:3 val;
}

addr8_de_rel: [DE + data8] is DE & data8 {
	local addr:3 = zext(DE)+zext(data8:1); 
	local val:3 = zext(*[ram]:2 addr);
	export *[const]:3 val;
}

addr8_sp_rel: ["SP" + data8] is data8 {
	local addr:3 = zext(SP)+zext(data8:1); 
	local val:3 = zext(*[ram]:2 addr);
	export *[const]:3 val;
}

es_hl_b_ind: ES:hl_b_ind is ES & hl_b_ind { local tmp:3 = (zext(ES) << 16) + hl_b_ind; export *[const]:3 tmp; }
es_hl_c_ind: ES:hl_c_ind is ES & hl_c_ind { local tmp:3 = (zext(ES) << 16) + hl_c_ind; export *[const]:3 tmp; }
es_addr16_abs: ES:addr16_abs is ES & addr16_abs { local tmp:3 = (zext(ES) << 16) + addr16_abs; export *[const]:3 tmp; }
es_de_ind: ES:de_ind is de_ind & ES { local tmp:3 = zext(ES << 16) + de_ind; export *[const]:3 tmp;}
es_hl_ind: ES:hl_ind is hl_ind & ES { local tmp:3 = zext(ES << 16) + hl_ind; export *[const]:3 tmp;}

addr16_es_rel: ES:addr16_rel is ES & addr16_rel { local tmp:3 = (zext(ES) << 16) + addr16_rel; export *[const]:3 tmp; }
es_addr8_hl_rel: ES:addr8_hl_rel is ES & addr8_hl_rel { local tmp:3 = (zext(ES) << 16) + addr8_hl_rel; export *[const]:3 tmp; }
es_addr8_de_rel: ES:addr8_de_rel is ES & addr8_de_rel { local tmp:3 = (zext(ES) << 16) + addr8_de_rel; export *[const]:3 tmp; }


word_b: addr16_abs[B] is addr16_abs & B { local tmp:3 = addr16_abs + zext(B)*2; export *[const]:3 tmp; }
word_c: addr16_abs[C] is addr16_abs & C { local tmp:3 = addr16_abs + zext(C)*2; export *[const]:3 tmp; }
word_bc: addr16_abs[BC] is addr16_abs & BC { local tmp:3 = addr16_abs + zext(BC)*2; export *[const]:3 tmp; }

es_word_b: ES:addr16_abs[B] is addr16_abs & B & ES { local tmp:3 = (zext(ES) << 16) + addr16_abs + zext(B)*2; export *[const]:3 tmp; }
es_word_c: ES:addr16_abs[C] is addr16_abs & C & ES { local tmp:3 = (zext(ES) << 16) + addr16_abs + zext(C)*2; export *[const]:3 tmp; }
es_word_bc: ES:addr16_abs[BC] is addr16_abs & BC & ES { local tmp:3 = (zext(ES) << 16) + addr16_abs + zext(BC)*2; export *[const]:3 tmp; }

#mov
:mov reg8_xacbedlh, data8 is ophi=0x5 & reg8_xacbedlh ; data8 { reg8_xacbedlh = data8; }
:mov saddr, data8 is op=0xCD; saddr; data8 { *[ram]:1 saddr = data8; }
:mov sfr, data8 is op=0xCE; sfr; data8 { *[ram]:1 sfr = data8; }
:mov addr16_abs, data8 is op=0xCF; addr16_abs; data8 { *[ram]:1 addr16_abs = data8; }
:mov A, reg_xcbedlh_low is ophi=0x6 & reg_xcbedlh_low & A { A = reg_xcbedlh_low; }
:mov reg_xcbedlh_low, A is ophi=0x7 & reg_xcbedlh_low & A { reg_xcbedlh_low = A; }
:mov A, saddr is op=0x8D; saddr & A { A = *[ram]:1 saddr; }
:mov saddr, A is op=0x9D; saddr & A { *[ram]:1 saddr = A; }
:mov A, sfr is op=0x8E; sfr & A { A = *[ram]:1 sfr; }
:mov sfr, A is op=0x9E; sfr & A { *[ram]:1 sfr = A; }
:mov A, addr16_abs is op=0x8F; addr16_abs & A { A = *[ram]:1 addr16_abs; }
:mov addr16_abs, A is op=0x9F; addr16_abs & A { *[ram]:1 addr16_abs = A; }
:mov PSW, data8 is op=0xCE; op=0xFA; data8 & PSW { PSW = data8; }
:mov A, PSW is op=0x8E; op=0xFA & PSW & A { A = PSW; }
:mov PSW, A is op=0x9E; op=0xFA & PSW & A { PSW = A; }
:mov ES, data8 is op=0x41; data8 & ES { ES = data8; }
:mov ES, saddr is op=0x61; op=0xB8;  saddr & ES { ES = *[ram]:1 saddr; }
:mov A, ES is op=0x8E; op=0xFD & ES & A { A = ES; }
:mov ES, A is op=0x9E; op=0xFD & ES & A { ES = A; }
:mov CS, data8 is op=0xCE; op=0xFC; data8 & CS { CS = data8; }


:mov A, CS is op=0x8E; op=0xFC & A & CS { A = CS; }
:mov CS, A is op=0x9E; op=0xFC & A & CS { CS = A; }
:mov A, de_ind is op=0x89 & de_ind & A { A = *[ram]:1 de_ind; }
:mov de_ind, A is op=0x99 & de_ind & A { *[ram]:1 de_ind = A; }
:mov addr8_de_rel, data8 is op=0xCA; addr8_de_rel; data8 { *[ram]:1 addr8_de_rel = data8; }
:mov A, addr8_de_rel is op=0x8A; addr8_de_rel & A { A = *[ram]:1 addr8_de_rel; }
:mov addr8_de_rel, A is op=0x9A; addr8_de_rel & A { *[ram]:1 addr8_de_rel = A; }
:mov A, hl_ind is op=0x8B & hl_ind & A { A = *[ram]:1 hl_ind; }
:mov hl_ind, A is op=0x9B & hl_ind & A { *[ram]:1 hl_ind = A; }
:mov addr8_hl_rel, data8 is op=0xCC; addr8_hl_rel; data8 { *[ram]:1 addr8_hl_rel = data8; }
:mov A, addr8_hl_rel is op=0x8C; addr8_hl_rel & A { A = *[ram]:1 addr8_hl_rel; }
:mov addr8_hl_rel, A is op=0x9C; addr8_hl_rel & A { *[ram]:1 addr8_hl_rel = A; }
:mov A, hl_b_ind is op=0x61; op=0xC9 & hl_b_ind & A { A = *[ram]:1 hl_b_ind; }
:mov hl_b_ind, A is op=0x61; op=0xD9 & hl_b_ind & A { *[ram]:1 hl_b_ind = A; }
:mov A, hl_c_ind is op=0x61; op=0xE9 & hl_c_ind & A { A = *[ram]:1 hl_c_ind; }
:mov hl_c_ind, A is op=0x61; op=0xF9 & hl_c_ind & A { *[ram]:1 hl_c_ind = A; }
:mov word_b, data8 is op=0x19; word_b ; data8 { *[ram]:1 word_b = data8; }
:mov A, word_b is op=0x09; word_b & A { A = *[ram]:1 word_b; }
:mov word_b, A is op=0x18; word_b & A { *[ram]:1 word_b = A; }
:mov word_c, data8 is op=0x38; word_c ; data8 { *[ram]:1 word_c = data8; }
:mov A, word_c is op=0x29; word_c & A { A = *[ram]:1 word_c; }
:mov word_c, A is op=0x28; word_c & A { *[ram]:1 word_c = A; }
:mov word_bc, data8 is op=0x39; word_bc ; data8 { *[ram]:1 word_bc = data8; }
:mov A, word_bc is op=0x49; word_bc & A { A = *[ram]:1 word_bc; }
:mov word_bc, A is op=0x48; word_bc & A { *[ram]:1 word_bc = A; }
:mov addr8_sp_rel, data8 is op=0xC8; addr8_sp_rel; data8 & A { *[ram]:1 addr8_sp_rel = data8; }
:mov A, addr8_sp_rel is op=0x88; addr8_sp_rel & A { A = *[ram]:1 addr8_sp_rel; }
:mov addr8_sp_rel, A is op=0x98; addr8_sp_rel & A { *[ram]:1 addr8_sp_rel = A; }
:mov B, saddr is op=0xE8; saddr & B { B = *[ram]:1 saddr; }
:mov B, addr16_abs is op=0xE9; addr16_abs & B { B = *[ram]:1 addr16_abs; }
:mov C, saddr is op=0xF8; saddr & C { C = *[ram]:1 saddr; }
:mov C, addr16_abs is op=0xF9; addr16_abs & C { C = *[ram]:1 addr16_abs; }
:mov X, saddr is op=0xD8; saddr & X { X = *[ram]:1 saddr; }
:mov X, addr16_abs is op=0xD9; addr16_abs & X { X = *[ram]:1 addr16_abs; }
:mov es_addr16_abs, data8 is op=0x11; op=0xCF; es_addr16_abs; data8 { *[ram]:1 es_addr16_abs = data8; }
:mov A, es_addr16_abs is op=0x11; op=0x8F; es_addr16_abs & A { A = *[ram]:1 es_addr16_abs; }
:mov es_addr16_abs, A is op=0x11; op=0x9F; es_addr16_abs & A { *[ram]:1 es_addr16_abs = A; }
:mov A, es_de_ind is op=0x11; op=0x89 & es_de_ind & A { A = *[ram]:1 es_de_ind; }
:mov es_de_ind, A is op=0x11; op=0x99 & es_de_ind & A { *[ram]:1 es_de_ind = A; }
:mov es_addr8_de_rel, data8 is op=0x11; op=0xCA; es_addr8_de_rel; data8 { *[ram]:1 es_addr8_de_rel = data8; }
:mov A, es_addr8_de_rel is op=0x11; op=0x8A; es_addr8_de_rel & A { A = *[ram]:1 es_addr8_de_rel; }
:mov es_addr8_de_rel, A is op=0x11; op=0x9A; es_addr8_de_rel & A { *[ram]:1 es_addr8_de_rel = A; }
:mov A, es_hl_ind is op=0x11; op=0x8B & es_hl_ind & A { A = *[ram]:1 es_hl_ind; }

:mov es_hl_ind, A is op=0x11; op=0x9B & es_hl_ind & A { *[ram]:1 es_hl_ind = A; }
:mov es_addr8_hl_rel, data8 is op=0x11; op=0xCC; es_addr8_hl_rel; data8 { *[ram]:1 es_addr8_hl_rel = data8; }
:mov A, es_addr8_hl_rel is op=0x11; op=0x8C; es_addr8_hl_rel & A { A = *[ram]:1 es_addr8_hl_rel; }
:mov es_addr8_hl_rel, A is op=0x11; op=0x9C; es_addr8_hl_rel & A { *[ram]:1 es_addr8_hl_rel = A; }
:mov A, es_hl_b_ind is op=0x11; op=0x61; op=0xC9; es_hl_b_ind & A { A = *[ram]:1 es_hl_b_ind; }
:mov es_hl_b_ind, A is op=0x11; op=0x61; op=0xD9; es_hl_b_ind & A { *[ram]:1 es_hl_b_ind = A; }
:mov A, es_hl_c_ind is op=0x11; op=0x61; op=0xE9; es_hl_c_ind & A { A = *[ram]:1 es_hl_c_ind; }
:mov es_hl_c_ind, A is op=0x11; op=0x61; op=0xF9; es_hl_c_ind & A { *[ram]:1 es_hl_c_ind = A; }
:mov es_word_b, data8 is op=0x11; op=0x19; es_word_b ; data8 { *[ram]:1 es_word_b = data8; }
:mov A, es_word_b is op=0x11; op=0x09; es_word_b & A { A = *[ram]:1 es_word_b; }
:mov es_word_b, A is op=0x11; op=0x18; es_word_b & A { *[ram]:1 es_word_b = A; }
:mov es_word_c, data8 is op=0x11; op=0x38; es_word_c ; data8 { *[ram]:1 es_word_c = data8; }
:mov A, es_word_c is op=0x11; op=0x29; es_word_c & A { A = *[ram]:1 es_word_c; }
:mov es_word_c, A is op=0x11; op=0x28; es_word_c & A { *[ram]:1 es_word_c = A; }
:mov es_word_bc, data8 is op=0x11; op=0x39; es_word_bc ; data8 { *[ram]:1 es_word_bc = data8; }
:mov A, es_word_bc is op=0x11; op=0x49; es_word_bc & A { A = *[ram]:1 es_word_bc; }
:mov es_word_bc, A is op=0x11; op=0x48; es_word_bc & A { *[ram]:1 es_word_bc = A; }
:mov B, es_addr16_abs is op=0x11; op=0xE9; es_addr16_abs & B { B = *[ram]:1 es_addr16_abs; }
:mov C, es_addr16_abs is op=0x11; op=0xF9; es_addr16_abs & C { C = *[ram]:1 es_addr16_abs; }
:mov X, es_addr16_abs is op=0x11; op=0xD9; es_addr16_abs & X { X = *[ram]:1 es_addr16_abs; }


#xch
macro _xch(a, b) {
	local tmp:1 = a;
	a = b;
	b = tmp;
}
macro _xch_mem(a, b) {
	local tmp:1 = *[ram]:1 a;
	*[ram]:1 a = b;
	b = tmp;
}  
:xch A, X is op=0x08 & A & X { _xch(A, X);}
:xch A, reg_cbedlh is op=0x61; ophi=0x8 & reg_cbedlh & A { _xch(A, reg_cbedlh); }
:xch A, saddr is op=0x61; op=0xA8; saddr & A { _xch_mem(saddr, A); }
:xch A, sfr is op=0x61; op=0xAB; sfr & A { _xch_mem(sfr, A); }
:xch A, addr16_abs is op=0x61; op=0xAA; addr16_abs & A { _xch_mem(addr16_abs, A); }
:xch A, de_ind is op=0x61; op=0xAE; de_ind & A { _xch_mem(de_ind, A); }
:xch A, addr8_de_rel is op=0x61; op=0xAF; addr8_de_rel & A { _xch_mem(addr8_de_rel, A); }
:xch A, hl_ind is op=0x61; op=0xAC; hl_ind & A { _xch_mem(hl_ind, A); }
