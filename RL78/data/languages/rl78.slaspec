#or
:or A, "#"data8 is op=0x6c; data8 & A { local tmp:1 = A | data8; A = tmp; Z = tmp == 0;}
:or saddr, "#"data8 is op=0x6a; saddr; data8 { local tmp:1 = (*[ram]:1 saddr) | data8; *[ram]:1 saddr = tmp; Z = tmp == 0; }
:or A, reg_xcbedlh is op=0x61; ophi=0x6 & reg_xcbedlh & A { local tmp:1 = A | reg_xcbedlh; A = tmp; Z = tmp == 0; }
:or reg8_xacbedlh, A is op=0x61; ophi=0x6 & reg8_xacbedlh & A { local tmp:1 = reg8_xacbedlh | A; reg8_xacbedlh = tmp; Z = tmp == 0; }
:or A, saddr is op=0x6B; saddr & A { local tmp:1 = A | (*[ram]:1 saddr); A = tmp; Z = tmp == 0; }
:or A, addr16_abs is op=0x6F; addr16_abs & A { local tmp:1 = A | (*[ram]:1 addr16_abs); A = tmp; Z = tmp == 0; }
:or A, hl_ind is op=0x6D & hl_ind & A { local tmp:1 = A | (*[ram]:1 hl_ind); A = tmp; Z = tmp == 0; }
:or A, addr8_hl_rel is op=0x6E & addr8_hl_rel & A { local tmp:1 = A | (*[ram]:1 addr8_hl_rel); A = tmp; Z = tmp == 0; }
:or A, hl_b_ind is op=0x61; op=0xE0 & hl_b_ind & A { local tmp:1 = A | (*[ram]:1 hl_b_ind); A = tmp; Z = tmp == 0; }
:or A, hl_c_ind is op=0x61; op=0xE2 & hl_c_ind & A { local tmp:1 = A | (*[ram]:1 hl_c_ind); A = tmp; Z = tmp == 0; }
:or A, es_addr16_abs is op=0x11; op=0x6F; es_addr16_abs & A { local tmp:1 = A | (*[ram]:1 es_addr16_abs); A = tmp; Z = tmp == 0; }
:or A, es_hl_ind is op=0x11; op=0x6D & es_hl_ind & A { local tmp:1 = A | (*[ram]:1 es_hl_ind); A = tmp; Z = tmp == 0; }
:or A, es_addr8_hl_rel is op=0x11; op=0x6E ; es_addr8_hl_rel & A { local tmp:1 = A | (*[ram]:1 es_addr8_hl_rel); A = tmp; Z = tmp == 0; }
:or A, es_hl_b_ind is op=0x11; op=0x61; op=0xE0 & es_hl_b_ind & A { local tmp:1 = A | (*[ram]:1 es_hl_b_ind); A = tmp; Z = tmp == 0; }
:or A, es_hl_c_ind is op=0x11; op=0x61; op=0xE2 & es_hl_c_ind & A { local tmp:1 = A | (*[ram]:1 es_hl_c_ind); A = tmp; Z = tmp == 0; }



#xor
:xor A, "#"data8 is op=0x7c; data8 & A { local tmp:1 = A ^ data8;  A = tmp; Z = tmp == 0; }
:xor saddr, "#"data8 is op=0x7a; saddr; data8 { local tmp:1 = (*[ram]:1 saddr) ^ data8; *[ram]:1 saddr = tmp; Z = tmp == 0; }
:xor A, reg_xcbedlh is op=0x61; ophi=0x7 & reg_xcbedlh & A { local tmp:1 = A ^ reg_xcbedlh; A = tmp; Z = tmp == 0; }
:xor reg8_xacbedlh, A is op=0x61; ophi=0x7 & reg8_xacbedlh & A { local tmp:1 = reg8_xacbedlh ^ A; reg8_xacbedlh = tmp; Z = tmp == 0; }
:xor A, saddr is op=0x7B; saddr & A { local tmp:1 = A ^ (*[ram]:1 saddr); A = tmp; Z = tmp == 0; }
:xor A, addr16_abs is op=0x7F; addr16_abs & A { local tmp:1 = A ^ (*[ram]:1 addr16_abs); A = tmp; Z = tmp == 0; }
:xor A, hl_ind is op=0x7D & hl_ind & A { local tmp:1 = A ^ (*[ram]:1 hl_ind); A = tmp; Z = tmp == 0; }
:xor A, addr8_hl_rel is op=0x7E & addr8_hl_rel & A { local tmp:1 = A ^ (*[ram]:1 addr8_hl_rel); A = tmp; Z = tmp == 0; }
:xor A, hl_b_ind is op=0x61; op=0xF0 & hl_b_ind & A { local tmp:1 = A ^ (*[ram]:1 hl_b_ind); A = tmp; Z = tmp == 0; }
:xor A, hl_c_ind is op=0x61; op=0xF2 & hl_c_ind & A { local tmp:1 = A ^ (*[ram]:1 hl_c_ind); A = tmp; Z = tmp == 0; }
:xor A, es_addr16_abs is op=0x11; op=0x7F; es_addr16_abs & A { local tmp:1 = A ^ (*[ram]:1 es_addr16_abs); A = tmp; Z = tmp == 0; }
:xor A, es_hl_ind is op=0x11; op=0x7D & es_hl_ind & A { local tmp:1 = A ^ (*[ram]:1 es_hl_ind); A = tmp; Z = tmp == 0; }
:xor A, es_addr8_hl_rel is op=0x11; op=0x7E ; es_addr8_hl_rel & A { local tmp:1 = A ^ (*[ram]:1 es_addr8_hl_rel); A = tmp; Z = tmp == 0; }
:xor A, es_hl_b_ind is op=0x11; op=0x61; op=0xF0 & es_hl_b_ind & A { local tmp:1 = A ^ (*[ram]:1 es_hl_b_ind); A = tmp; Z = tmp == 0; }
:xor A, es_hl_c_ind is op=0x11; op=0x61; op=0xF2 & es_hl_c_ind & A { local tmp:1 = A ^ (*[ram]:1 es_hl_c_ind); A = tmp; Z = tmp == 0; }

#cmp
macro cmp_flags(dst, src) {
	local out:1 = dst - src;
	Z = out == 0;
	CY = sborrow(dst, src);
	AC = (src & 0b1111) > (dst & 0b1111);
}
:cmp A, "#"data8 is op=0x4c; data8 & A { cmp_flags(A, data8); }
:cmp saddr, "#"data8 is op=0x4a; saddr; data8 { cmp_flags(*[ram]:1 saddr, data8); }
:cmp A, reg_xcbedlh is op=0x61; ophi=0x4 & reg_xcbedlh & A { cmp_flags(A, reg_xcbedlh); }
:cmp reg8_xacbedlh, A is op=0x61; ophi=0x4 & reg8_xacbedlh & A { cmp_flags(reg8_xacbedlh, A); }
:cmp A, saddr is op=0x4B; saddr & A { cmp_flags(A, *[ram]:1 saddr); }
:cmp A, addr16_abs is op=0x4F; addr16_abs & A { cmp_flags( A, *[ram]:1 addr16_abs); }
:cmp A, hl_ind is op=0x4D & hl_ind & A { cmp_flags(A, *[ram]:1 hl_ind); }
:cmp A, addr8_hl_rel is op=0x4E & addr8_hl_rel & A { cmp_flags(A, *[ram]:1 addr8_hl_rel); }
:cmp A, hl_b_ind is op=0x61; op=0xC0 & hl_b_ind & A { cmp_flags(A, *[ram]:1 hl_b_ind); }
:cmp A, hl_c_ind is op=0x61; op=0xC2 & hl_c_ind & A { cmp_flags(A, *[ram]:1 hl_c_ind); }
:cmp addr16_abs, data8 is op=0x40; addr16_abs; data8 { cmp_flags(*[ram]:1 addr16_abs, data8); }
:cmp A, es_addr16_abs is op=0x11; op=0x4F; es_addr16_abs & A { cmp_flags(A, *[ram]:1 es_addr16_abs); }
:cmp A, es_hl_ind is op=0x11; op=0x4D & es_hl_ind & A { cmp_flags(A, *[ram]:1 es_hl_ind); }
:cmp A, es_addr8_hl_rel is op=0x11; op=0x4E ; es_addr8_hl_rel & A { cmp_flags(A, *[ram]:1 es_addr8_hl_rel); }
:cmp A, es_hl_b_ind is op=0x11; op=0x61; op=0xC0 & es_hl_b_ind & A { cmp_flags(A, *[ram]:1 es_hl_b_ind); }
:cmp A, es_hl_c_ind is op=0x11; op=0x61; op=0xC2 & es_hl_c_ind & A { cmp_flags(A, *[ram]:1 es_hl_c_ind); }
:cmp es_addr16_abs, data8 is op=0x11; op=0x40; es_addr16_abs; data8 { cmp_flags(*[ram]:1 es_addr16_abs, data8); }

#cmp0
macro cmp0(x) {
	Z = x == 0;
	AC = 0;
	CY = 0;
}

macro cmp(x, y) {
	local cmptmp:1 = x - y;
	Z = cmptmp == 0;
	CY = (cmptmp != 0) || (x == 0) || (y == 0);
	AC = sborrow(x, y) != 0;
}

:cmp0 A is op=0xD1 & A { cmp0(A); }
:cmp0 X is op=0xD0 & X { cmp0(X); }
:cmp0 B is op=0xD3 & B { cmp0(B); }
:cmp0 C is op=0xD2 & C { cmp0(C); }
:cmp0 saddr is op=0xD4; saddr { local tmp:1 = *[ram] saddr; cmp0(tmp); }
:cmp0 addr16_abs is op=0xD5; addr16_abs { local tmp:1 = *[ram] addr16_abs; cmp0(tmp); }
:cmp0 addr16_es_rel is op=0x11; op=0xd5; addr16_es_rel { local tmp:1 = *[ram] addr16_es_rel; cmp0(tmp); }

#cmps
:cmps X, addr8_hl_rel is op=0x61; op=0xde; addr8_hl_rel & X { local tmp:1 = *[ram]:1 addr8_hl_rel; cmp(X, tmp); }
:cmps X, es_addr8_hl_rel is op=0x11; op=0x61; op=0xde; es_addr8_hl_rel & X { local tmp:1 = *[ram]:1 es_addr8_hl_rel; cmp(X, tmp); }

#addw
macro addw_flags(dst, src) {
	local tmp:2 = dst + src;
	Z = tmp == 0;
	# AC is undef
	CY = carry(dst, src);
	dst = tmp;
}
:addw AX, data16 is op=0x04 & AX; data16 { addw_flags(AX, data16);}
:addw AX, AX2 is op=0x01 & AX & AX2 { addw_flags(AX, AX);}
:addw AX, BC is op=0x03 & AX & BC { addw_flags(AX, BC);}
:addw AX, DE is op=0x05 & AX & DE { addw_flags(AX, DE);}
:addw AX, HL is op=0x07 & AX & HL { addw_flags(AX, HL);}
:addw AX, saddrp is op=0x06 & AX; saddrp { addw_flags(AX, *[ram]:2 saddrp);}
:addw AX, addr16_abs is op=0x02 & AX; addr16_abs { addw_flags(AX, *[ram]:2 addr16_abs);}
:addw AX, addr8_hl_rel is op=0x61; op=0x09; addr8_hl_rel & AX { addw_flags(AX, *[ram]:2 addr8_hl_rel);}
:addw AX, es_addr16_abs is op=0x11; op=0x02; es_addr16_abs & AX { addw_flags(AX, *[ram]:2 es_addr16_abs);}
:addw AX, es_addr8_hl_rel is op=0x11; op=0x61; op=0x09; es_addr8_hl_rel & AX { addw_flags(AX, *[ram]:2 es_addr8_hl_rel);}

#subw
macro subw_flags(dst, src) {
	local tmp:2 = dst - src;
	Z = tmp == 0;
	# AC is undef
	CY = sborrow(dst, src);
	dst = tmp;
}
:subw AX, data16 is op=0x24 & AX; data16 { subw_flags(AX, data16);}
:subw AX, BC is op=0x23 & AX & BC { subw_flags(AX, BC);}
:subw AX, DE is op=0x25 & AX & DE { subw_flags(AX, DE);}
:subw AX, HL is op=0x27 & AX & HL { subw_flags(AX, HL);}
:subw AX, saddrp is op=0x26 & AX; saddrp { subw_flags(AX, *[ram]:2 saddrp);}
:subw AX, addr16_abs is op=0x22 & AX; addr16_abs { subw_flags(AX, *[ram]:2 addr16_abs);}
:subw AX, addr8_hl_rel is op=0x61; op=0x29; addr8_hl_rel & AX { subw_flags(AX, *[ram]:2 addr8_hl_rel);}
:subw AX, es_addr16_abs is op=0x11; op=0x22; es_addr16_abs & AX { subw_flags(AX, *[ram]:2 es_addr16_abs);}
:subw AX, es_addr8_hl_rel is op=0x11; op=0x61; op=0x29; es_addr8_hl_rel & AX { subw_flags(AX, *[ram]:2 es_addr8_hl_rel);}


#cmpw
macro cmpw(a, b) {
	Z = (a - b) == 0;
	CY = sborrow(a, b);
	AC = 0;
}
:cmpw AX, data16 is op=0x44 ; data16 & AX { cmpw(AX, data16); }
:cmpw AX, BC is op=0x45 & AX & BC { cmpw(AX, BC); }
:cmpw AX, DE is op=0x46 & AX & DE { cmpw(AX, DE); }
:cmpw AX, HL is op=0x47 & AX & HL { cmpw(AX, HL); }
:cmpw AX, saddrp is op=0x46; saddrp & AX { cmpw(AX, *[ram]:2 saddrp); }
:cmpw AX, addr16_abs is op=0x42; addr16_abs & AX { cmpw(AX, *[ram]:2 addr16_abs); }
:cmpw AX, addr8_hl_rel is op=0x61; op=0x49; addr8_hl_rel & AX { cmpw(AX, *[ram]:2 addr8_hl_rel); }
:cmpw AX, es_addr16_abs is op=0x11; op=0x42; es_addr16_abs & AX { cmpw(AX, *[ram]:2 es_addr16_abs); }
:cmpw AX, es_addr8_hl_rel is op=0x11; op=0x61; op=0x49; es_addr8_hl_rel & AX { cmpw(AX, *[ram]:2 es_addr8_hl_rel); }

# mul
:mulu X is op=0xd6 & X & AX & A { AX = zext(A) * zext(X); }
:mulhu is op=0xce ; op=0xFB ; op=0x01 & BCAX & BC & AX { BCAX = zext(AX) * zext(BC); }
:mulh is op=0xce ; op=0xFB ; op=0x02 & BCAX & BC & AX { BCAX = sext(AX) * sext(BC); }
:divhu is op=0xce ; op=0xFB ; op=0x03 & AX & DE { 
	local div:2 = AX / DE;
	local rem:2 = AX % DE;
	AX = div;
	DE = rem;
}
:divwu is op=0xce ; op=0xFB ; op=0x0b & BCAX & HLDE {
	local div:4 = BCAX / HLDE;
	local rem:4 = BCAX % HLDE;
	BCAX = div;
	HLDE = rem;
}
:machu is op=0xce ; op=0xFB ; op=0x05 & AX & BC {
	local tmp:8 = zext(MACR) + zext(AX) * zext(BC);
	MACR = MACR + zext(AX) * zext(BC);
	CY = MACR != tmp:4;
	AC = 0;
}
:mach is op=0xce ; op=0xFB ; op=0x06 & AX & BC {
		local tmp:8 =  sext(MACR) + sext(AX) * sext(BC);
		MACR = MACR + sext(AX) * sext(BC);
		CY = MACR != tmp:4;
		AC = MACR s< 0;
}

#inc
macro inc_flags(v) {
	Z = v == 0xFF;
	AC = (v & 0b1111) == 0b1111;
}
:inc reg8_xacbedlh is ophi=0x8 & reg8_xacbedlh { inc_flags(reg8_xacbedlh); reg8_xacbedlh = reg8_xacbedlh + 1; }
:inc saddr is op=0xa4; saddr { inc_flags(*[ram]:1 saddr); *[ram]:1 saddr = (*[ram]:1 saddr) + 1; }
:inc addr16_abs is op=0xa0; addr16_abs { inc_flags(*[ram]:1 addr16_abs); *[ram]:1 addr16_abs = (*[ram]:1 addr16_abs) + 1; }
:inc addr8_hl_rel is op=0x61; op=0x59; addr8_hl_rel { inc_flags(*[ram]:1 addr8_hl_rel); *[ram]:1 addr8_hl_rel = (*[ram]:1 addr8_hl_rel) + 1; }
:inc es_addr16_abs is op=0x11; op=0xa0; es_addr16_abs { inc_flags(*[ram]:1 es_addr16_abs); *[ram]:1 es_addr16_abs = (*[ram]:1 es_addr16_abs) + 1; }
:inc es_addr8_hl_rel is op=0x11; op=0x61; op=0x59; es_addr8_hl_rel { inc_flags(*[ram]:1 es_addr8_hl_rel); *[ram]:1 es_addr8_hl_rel = (*[ram]:1 es_addr8_hl_rel) + 1; }


# dec
macro dec_flags(v) {
	Z = v == 1;
	AC = v == 0;
}
:dec reg8_xacbedlh is ophi=0x9 & reg8_xacbedlh { dec_flags(reg8_xacbedlh); reg8_xacbedlh = reg8_xacbedlh - 1; }
:dec saddr is op=0xb4; saddr { dec_flags(*[ram]:1 saddr); *[ram]:1 saddr = (*[ram]:1 saddr) - 1; }
:dec addr16_abs is op=0xb0; addr16_abs { dec_flags(*[ram]:1 addr16_abs); *[ram]:1 addr16_abs = (*[ram]:1 addr16_abs) - 1; }
:dec addr8_hl_rel is op=0x61; op=0x69; addr8_hl_rel { dec_flags(*[ram]:1 addr8_hl_rel); *[ram]:1 addr8_hl_rel = (*[ram]:1 addr8_hl_rel) - 1; }
:dec es_addr16_abs is op=0x11; op=0xb0; es_addr16_abs { dec_flags(*[ram]:1 es_addr16_abs); *[ram]:1 es_addr16_abs = (*[ram]:1 es_addr16_abs) - 1; }
:dec es_addr8_hl_rel is op=0x11; op=0x61; op=0x69; es_addr8_hl_rel { dec_flags(*[ram]:1 es_addr8_hl_rel); *[ram]:1 es_addr8_hl_rel = (*[ram]:1 es_addr8_hl_rel) - 1; }

#incw
:incw AX is op=0xa1 & AX { AX = AX + 1; }
:incw BC is op=0xa3 & BC { BC = BC + 1; }
:incw DE is op=0xa5 & DE { DE = DE + 1; }
:incw HL is op=0xa7 & HL { HL = HL + 1; }
:incw saddr is op=0xa6; saddr { *[ram]:2 saddr = (*[ram]:2 saddr) + 1; }
:incw addr16_abs is op=0xa2; addr16_abs { *[ram]:2 addr16_abs = (*[ram]:2 addr16_abs) + 1; }
:incw addr8_hl_rel is op=0x61; op=0x79; addr8_hl_rel { *[ram]:2 addr8_hl_rel = (*[ram]:2 addr8_hl_rel) + 1; }
:incw es_addr16_abs is op=0x11; op=0xa2; es_addr16_abs { *[ram]:2 es_addr16_abs = (*[ram]:2 es_addr16_abs) + 1; }
:incw es_addr8_hl_rel is op=0x11; op=0x61; op=0x79; es_addr8_hl_rel { *[ram]:2 es_addr8_hl_rel = (*[ram]:2 es_addr8_hl_rel) + 1; }

#decw
:decw AX is op=0xb1 & AX { AX = AX - 1; }
:decw BC is op=0xb3 & BC { BC = BC - 1; }
:decw DE is op=0xb5 & DE { DE = DE - 1; }
:decw HL is op=0xb7 & HL { HL = HL - 1; }
:decw saddr is op=0xb6; saddr { *[ram]:2 saddr = (*[ram]:2 saddr) - 1; }
:decw addr16_abs is op=0xb2; addr16_abs { *[ram]:2 addr16_abs = (*[ram]:2 addr16_abs) - 1; }
:decw addr8_hl_rel is op=0x61; op=0x89; addr8_hl_rel { *[ram]:2 addr8_hl_rel = (*[ram]:2 addr8_hl_rel) - 1; }
:decw es_addr16_abs is op=0x11; op=0xb2; es_addr16_abs { *[ram]:2 es_addr16_abs = (*[ram]:2 es_addr16_abs) - 1; }
:decw es_addr8_hl_rel is op=0x11; op=0x61; op=0x89; es_addr8_hl_rel { *[ram]:2 es_addr8_hl_rel = (*[ram]:2 es_addr8_hl_rel) - 1; }

# shr
:shr A, immhi is op=0x31; immlo=0xA & imm7=0 & ophi > 0 & immhi & A  {
	CY = ((A >> (immhi - 1))&1) != 0; 
	A = A >> immhi;
}

#shrw
:shrw AX, immhi is op=0x31 ; immhi & immlo=0xE & AX { 
	CY = ((AX >> (immhi - 1))&1) != 0;
	AX = AX >> immhi;
}

# shl
:shl A, immhi is op=0x31; immhi & ophi > 0 & immlo=0x9 & A { 
	CY = ((A >> (8 - immhi))&1) != 0;
	A = A << immhi;
}
:shl B, immhi is op=0x31; immhi & ophi > 0 & immlo=0x8 & B { 
	CY = ((B >> (8 - immhi))&1) != 0;
	B = B << immhi;
}
:shl C, immhi is op=0x31; immhi & ophi > 0 & immlo=0x7 & C { 
	CY = ((C >> (8 - immhi))&1) != 0;
	C = C << immhi;
}

# shlw
:shlw AX, immhi is op=0x31 ; immhi & ophi > 0 & immlo=0xD & AX { 
	CY = ((AX >> (16-immhi)) & 1) != 0;
	AX = AX << immhi;
}
:shlw BC, immhi is op=0x31 ; immhi & ophi > 0 & immlo=0xC & BC & AX { 
	CY = ((BC >> (16-immhi)) & 1) != 0;
	BC = BC << immhi;
}

# SAR
:sar A, immhi is op=0x31 ; immhi & ophi > 0 & immlo=0xB & A { 
	CY = ((A >> (immhi - 1)) & 1) != 0;
	A = A s>> immhi;
}

# sarw
:sarw AX, immhi is op=0x31 ; immhi & ophi > 0 & immlo=0xF & AX { 
	CY = ((AX >> (immhi - 1)) & 1) != 0;
	AX = AX s>> immhi;
}

#ror
:ror A, 1 is op=0x61; op=0xDB & A { 
	local lsb:1 = A & 1;
	A = (A >> 1) | (lsb << 7);
	CY = lsb==1;
}

#rol
:rol A, 1 is op=0x61; op=0xEB & A { 
	local msb:1 = A >> 7;
	A = (A << 1) | msb;
	CY = msb==1;
}

#rorc
:rorc A, 1 is op=0x61; op=0xFB & A { 
	local lsb:1 = A & 1;
	A = (A >> 1) | (CY << 7);
	CY = lsb==1;
}

#rolc
:rolc A, 1 is op=0x61; op=0xDC & A { 
	local msb:1 = A >> 7;
	A = (A << 1) | CY;
	CY = msb==1;
}

# rolwc
:rolwc AX, 1 is op=0x61; op=0xEE & AX { 
	local msb:2 = AX >> 15;
	AX = (AX << 1) | zext(CY);
	CY = msb==1;
}
:rolwc BC, 1 is op=0x61; op=0xFE & BC { 
	local msb:2 = BC >> 15;
	BC = (BC << 1) | zext(CY);
	CY = msb==1;
}

# mov1
:mov1 "CY", saddr"."imm4_6 is op=0x71; imm7=0 & imm4_6 & immlo=0x4; saddr {
	local flag:1 = ((*[ram]:1 saddr) & (1 << imm4_6)) != 0;
	CY = flag; 
}
:mov1 "CY", sfr"."imm4_6 is op=0x71; imm7=0 & imm4_6 & immlo=0xC; sfr {
	local flag:1 = ((*[ram]:1 sfr) & (1 << imm4_6)) != 0;
	CY = flag;
}
:mov1 "CY", A^"."imm4_6 is op=0x71; imm7=1 & imm4_6 & immlo=0xC & A {
	local flag:1 = (A & (1 << imm4_6)) != 0;
	CY = flag;
