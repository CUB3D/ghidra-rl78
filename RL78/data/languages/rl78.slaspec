# xchw
:xchw AX, BC is op=0x33 & AX & BC { 
	local tmp1 = AX;
	AX = BC;
	BC = tmp1;
}
:xchw AX, DE is op=0x35 & AX & DE { 
	local tmp1 = AX;
	AX = DE;
	DE = tmp1;
}
:xchw AX, HL is op=0x37 & AX & HL { 
	local tmp1 = AX;
	AX = HL;
	HL = tmp1;
}

#onew
:onew AX is op=0xE6 & AX {
	AX = 1;
}
:onew BC is op=0xE7 & BC {
	BC = 1;
}

#clrw
:clrw AX is op=0xF6 & AX {
	AX = 0;
}
:clrw BC is op=0xF7 & BC {
	BC = 0;
}


#add
macro add_flags(out, src, dest) {
	out = src + dest;
	Z = out == 0;
	CY = carry(src, dest);
	AC = (src & 0b1111) + (dest & 0b1111) > 0b1111;
}
:add A, "#"data8 is op=0x0c; data8 & A { local tmp:1; add_flags(tmp, A, data8); A = tmp; }
:add saddr, "#"data8 is op=0x0a; saddr; data8 { local tmp:1; add_flags(tmp, *[ram]:1 saddr, data8); *[ram]:1 saddr = tmp; }
:add A, reg_xcbedlh is op=0x61; ophi=0x0 & reg_xcbedlh & A { local tmp:1; add_flags(tmp, A, reg_xcbedlh); A = tmp; }
:add reg8_xacbedlh, A is op=0x61; ophi=0x0 & reg8_xacbedlh & A { local tmp:1; add_flags(tmp, reg8_xacbedlh, A); reg8_xacbedlh = tmp; }
:add A, saddr is op=0x0B; saddr & A { local tmp:1; add_flags(tmp, A, *[ram]:1 saddr); A = tmp; }
:add A, addr16_abs is op=0x0F; addr16_abs & A { local tmp:1; add_flags(tmp, A, *[ram]:1 addr16_abs); A = tmp; }
:add A, hl_ind is op=0x0D & hl_ind & A { local tmp:1; add_flags(tmp, A, *[ram]:1 hl_ind); A = tmp; }
:add A, addr8_hl_rel is op=0x0E & addr8_hl_rel & A { local tmp:1; add_flags(tmp, A, *[ram]:1 addr8_hl_rel); A = tmp; }
:add A, hl_b_ind is op=0x61; op=0x80 & hl_b_ind & A { local tmp:1; add_flags(tmp, A, *[ram]:1 hl_b_ind); A = tmp; }
:add A, hl_c_ind is op=0x61; op=0x82 & hl_c_ind & A { local tmp:1; add_flags(tmp, A, *[ram]:1 hl_c_ind); A = tmp; }
:add A, es_addr16_abs is op=0x11; op=0x0F; es_addr16_abs & A { local tmp:1; add_flags(tmp, A, *[ram]:1 es_addr16_abs); A = tmp; }
:add A, es_hl_ind is op=0x11; op=0x0D & es_hl_ind & A { local tmp:1; add_flags(tmp, A, *[ram]:1 es_hl_ind); A = tmp; }
:add A, es_addr8_hl_rel is op=0x11; op=0x0E; es_addr8_hl_rel & A { local tmp:1; add_flags(tmp, A, *[ram]:1 es_addr8_hl_rel); A = tmp; }
:add A, es_hl_b_ind is op=0x11; op=0x61; op=0x80 & es_hl_b_ind & A { local tmp:1; add_flags(tmp, A, *[ram]:1 es_hl_b_ind); A = tmp; }
:add A, es_hl_c_ind is op=0x11; op=0x61; op=0x82 & es_hl_c_ind & A { local tmp:1; add_flags(tmp, A, *[ram]:1 es_hl_c_ind); A = tmp; }


#addc
macro addc_flags(out, src, dest) {
	local tmp = src + dest;
	out = tmp + CY;
	Z = out == 0;
	AC = ((src & 0b1111) + (dest & 0b1111) + CY) > 0b1111;
	CY = carry(src, dest) || carry(tmp, CY);
}
:addc A, "#"data8 is op=0x1c; data8 & A { local tmp:1; addc_flags(tmp, A, data8); A = tmp; }
:addc saddr, "#"data8 is op=0x1a; saddr; data8 { local tmp:1; addc_flags(tmp, *[ram]:1 saddr, data8); *[ram]:1 saddr = tmp; }
:addc A, reg_xcbedlh is op=0x61; ophi=0x1 & reg_xcbedlh & A { local tmp:1; addc_flags(tmp, A, reg_xcbedlh); A = tmp; }
:addc reg8_xacbedlh, A is op=0x61; ophi=0x1 & reg8_xacbedlh & A { local tmp:1; addc_flags(tmp, reg8_xacbedlh, A); reg8_xacbedlh = tmp; }
:addc A, saddr is op=0x1B; saddr & A { local tmp:1; addc_flags(tmp, A, *[ram]:1 saddr); A = tmp; }
:addc A, addr16_abs is op=0x1F; addr16_abs & A { local tmp:1; addc_flags(tmp, A, *[ram]:1 addr16_abs); A = tmp; }
:addc A, hl_ind is op=0x1D & hl_ind & A { local tmp:1; addc_flags(tmp, A, *[ram]:1 hl_ind); A = tmp; }
:addc A, addr8_hl_rel is op=0x1E & addr8_hl_rel & A { local tmp:1; addc_flags(tmp, A, *[ram]:1 addr8_hl_rel); A = tmp; }
:addc A, hl_b_ind is op=0x61; op=0x90 & hl_b_ind & A { local tmp:1; addc_flags(tmp, A, *[ram]:1 hl_b_ind); A = tmp; }
:addc A, hl_c_ind is op=0x61; op=0x92 & hl_c_ind & A { local tmp:1; addc_flags(tmp, A, *[ram]:1 hl_c_ind); A = tmp; }
:addc A, es_addr16_abs is op=0x11; op=0x1F; es_addr16_abs & A { local tmp:1; addc_flags(tmp, A, *[ram]:1 es_addr16_abs); A = tmp; }
:addc A, es_hl_ind is op=0x11; op=0x1D & es_hl_ind & A { local tmp:1; addc_flags(tmp, A, *[ram]:1 es_hl_ind); A = tmp; }
:addc A, es_addr8_hl_rel is op=0x11; op=0x1E; es_addr8_hl_rel & A { local tmp:1; addc_flags(tmp, A, *[ram]:1 es_addr8_hl_rel); A = tmp; }
:addc A, es_hl_b_ind is op=0x11; op=0x61; op=0x90 & es_hl_b_ind & A { local tmp:1; addc_flags(tmp, A, *[ram]:1 es_hl_b_ind); A = tmp; }
:addc A, es_hl_c_ind is op=0x11; op=0x61; op=0x92 & es_hl_c_ind & A { local tmp:1; add_flags(tmp, A, *[ram]:1 es_hl_c_ind); A = tmp; }

#sub
macro sub_flags(out, src, dest) {
	out = src - dest;
	Z = out == 0;
	CY = sborrow(src, dest);
	AC = (dest & 0b1111) > (src & 0b1111);
}
:sub A, "#"data8 is op=0x2c; data8 & A { local tmp:1; sub_flags(tmp, A, data8); A = tmp; }
:sub saddr, "#"data8 is op=0x2a; saddr; data8 { local tmp:1; sub_flags(tmp, *[ram]:1 saddr, data8); *[ram]:1 saddr = tmp; }
