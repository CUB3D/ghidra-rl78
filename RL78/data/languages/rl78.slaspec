:subc A, hl_b_ind is op=0x61; op=0xb0 & hl_b_ind & A { local tmp:1; subc_flags(tmp, A, *[ram]:1 hl_b_ind); A = tmp; }
:subc A, hl_c_ind is op=0x61; op=0xb2 & hl_c_ind & A { local tmp:1; subc_flags(tmp, A, *[ram]:1 hl_c_ind); A = tmp; }
:subc A, es_addr16_abs is op=0x11; op=0x3F; es_addr16_abs & A { local tmp:1; subc_flags(tmp, A, *[ram]:1 es_addr16_abs); A = tmp; }
:subc A, es_hl_ind is op=0x11; op=0x3D & es_hl_ind & A { local tmp:1; subc_flags(tmp, A, *[ram]:1 es_hl_ind); A = tmp; }
:subc A, es_addr8_hl_rel is op=0x11; op=0x3E ; es_addr8_hl_rel & A { local tmp:1; subc_flags(tmp, A, *[ram]:1 es_addr8_hl_rel); A = tmp; }
