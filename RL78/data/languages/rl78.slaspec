}
:mov1 sfr"."imm4_6, "CY" is op=0x71; imm7=0 & imm4_6 & immlo=0x9; sfr {
	*[ram]:1 sfr = (*[ram]:1 sfr) | (CY << imm4_6);
}
:mov1 A^"."imm4_6, "CY" is op=0x71; imm7=1 & imm4_6 & immlo=0x9 & A {
