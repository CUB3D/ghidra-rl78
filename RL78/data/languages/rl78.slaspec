}
:mov1 es_hl_ind"."imm4_6, "CY" is op=0x11; op=0x71; imm7=1 & imm4_6 & immlo=0x1 & es_hl_ind {
	*[ram]:1 es_hl_ind = (*[ram]:1 es_hl_ind) | (CY << imm4_6);
}


