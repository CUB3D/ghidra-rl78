	A = A & (~(1 << imm4_6));
}
:clr1 addr16_abs"."imm4_6 is op=0x71; imm7=0 & imm4_6 & immlo=0x8; addr16_abs {
	*[ram]:1 addr16_abs = (*[ram]:1 addr16_abs) & (~(1 << imm4_6));
}
