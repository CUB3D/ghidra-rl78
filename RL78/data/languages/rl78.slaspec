}

#set1
:"set1 CY" is op=0x71; op=0x80 { CY = 1; }

#clr1
:"clr1 CY" is op=0x71; op=0x88 { CY = 0; }

#not1
:"not1 CY" is op=0x71; op=0xc0 { CY = !CY; }

# call
:call AX is op=0x61; op=0xCA & AX { 
	local tmp:4 = inst_next;
	push32(tmp);
	local addr:3 = (zext(CS) << 16) | zext(AX);
	goto [addr];
}
:call BC is op=0x61; op=0xDA & BC { 
	local tmp:4 = inst_next;
	push32(tmp);
	local addr:3 = (zext(CS) << 16) | zext(BC);
	goto [addr];
}
:call DE is op=0x61; op=0xEA & DE { 
	local tmp:4 = inst_next;
	push32(tmp);
	local addr:3 = (zext(CS) << 16) | zext(DE);
	goto [addr];
}
:call HL is op=0x61; op=0xFA & HL {
	local tmp:4 = inst_next;
	push32(tmp);
	local addr:3 = (zext(CS) << 16) | zext(HL);
	goto [addr];
}
:call addr16_rel is op=0xFE; addr16_rel {
	local tmp:4 = inst_next;
	push32(tmp);
	local addr:3 = addr16_rel;
	goto [addr];
} 
:call addr16_abs is op=0xfd; addr16_abs {
	local tmp:4 = inst_next;
	push32(tmp);
	local addr:3 = addr16_abs;
	goto [addr];
}
:call addr20_abs is op=0xfc; addr20_abs {
	local tmp:4 = inst_next;
	push32(tmp);
	local addr:3 = addr20_abs;
	goto [addr];
}

# callt
callt_addr: val is data8 & data0_1=0 [ val = 80 + (data8 - 0x84)/8; ] { export *[const]:3 val; }
:callt callt_addr is op=0x61; callt_addr {
	local tmp:4 = inst_next;
	push32(tmp);
	local addr:3 = zext(*[ram]:2 callt_addr);
	goto [addr];
}

# brk
define pcodeop breakpoint;
:brk is op=0x61; op=0xcc { breakpoint(); }

# ret
:ret is op=0xD7 {
	local tmp:4 = 0;
	pop32(tmp);
    SP = SP + 1;
	local addr:3 = tmp:3;
	return [addr];
}

#reti
:reti is op=0x61; op=0xfc {
	local addr:3 = 0;
	pop24(addr);
	pop8(PSW);
	return [addr];
}

#retb
:retb is op=0x61; op=0xec { 
	local addr:3 = 0;
	pop24(addr);
	pop8(PSW);
	return [addr];
}


# push
:push PSW is op=0x61 ; op=0xDD & PSW {
	local tmp:2 = zext(PSW);
	push16(tmp);
}
:push AX is op=0xC1 & AX {
	push16(AX);
}
:push BC is op=0xC3 & BC {
	push16(BC);
}
:push DE is op=0xC5 & DE {
	push16(DE);
}
:push HL is op=0xC7 & HL {
	push16(HL);
}

#pop
:pop PSW is op=0x61 ; op=0xCD & PSW {
	local tmp:2 = 0;
	pop16(tmp);
	PSW = tmp:1;
}
:pop AX is op=0xC0 & AX {
	pop16(AX);
}
:pop BC is op=0xC2 & BC {
	pop16(BC);
}
:pop DE is op=0xC4 & DE {
	pop16(DE);
}
:pop HL is op=0xC6 & HL {
	pop16(HL);
}

#movw
:movw "SP", data16 is op=0xcb ; op=0xf8 ; data16 { local tmp:2 = data16 & 0xFFFE; SP = tmp;}
:movw "SP", AX is op=0xbe ; op=0xf8 & AX { SP = AX & 0xFFFE; }
:movw AX, "SP" is op=0xAe ; op=0xf8 & AX { AX = SP; }
# The datasheet also shows {BC, DE, HL} <- SP, these are actually implemented using 16 bit absolute addressing from the memory mapped SP register at 0x00FFF8


:addw "SP", data8 is op=0x10 ; data8 { SP = SP + data8; }
:subw "SP", data8 is op=0x20 ; data8 { SP = SP - data8; }

#br
:br AX is op=0x61; op=0xCB & AX {
	local tgt:3 = (zext(CS) << 16) | zext(AX); 
	goto [tgt];
}
:br addr8_rel is op=0xEF ; addr8_rel { goto [addr8_rel]; }
:br addr16_rel is op=0xEE ; addr16_rel { goto [addr16_rel]; }
:br addr16_abs is op=0xED ; addr16_abs { goto [addr16_abs]; }
:br addr20_abs is op=0xEC ; addr20_abs { goto [addr20_abs]; }

#bc
:bc addr8_rel is op=0xDC ; addr8_rel {
	if (CY == 0) goto <end>;
	goto [addr8_rel];
	<end>
}

# bnc
:bnc addr8_rel is op=0xDE ; addr8_rel {
	if (CY != 0) goto <end>;
	goto [addr8_rel];
	<end>
}

:bz addr8_rel is op=0xDD ; addr8_rel {
	if (Z == 0) goto <end>;
	goto [addr8_rel];
	<end>
}

#bnz
:bnz addr8_rel is op=0xDF ; addr8_rel {
	if (Z != 0) goto <end>;
	goto [addr8_rel];
	<end>
}

#bh
:bh addr8_rel is op=0x61 ; op=0xC3 ; addr8_rel {
	local flag:1 = (Z==1) || (CY==1);
	if (flag == 0) goto <end>;
	goto [addr8_rel];
	<end>
}

#bnh
:bnh addr8_rel is op=0x61 ; op=0xD3 ; addr8_rel {
	local flag:1 = (Z==1) || (CY==1);
	if (flag != 0) goto <end>;
	goto [addr8_rel];
	<end>
}

#bt
:bt saddr"."imm4_6, addr8_rel is op=0x31; imm7=0 & imm4_6 & immlo=2; saddr; addr8_rel { 
	local flag:1 = ((*[ram]:1 saddr) & (1 << imm4_6)) != 0;
	if (flag) goto addr8_rel;
}
:bt sfr"."imm4_6, addr8_rel is op=0x31; imm7=1 & imm4_6 & immlo=2; sfr; addr8_rel {
	local flag:1 = ((*[ram]:1 sfr) & (1 << imm4_6)) != 0;
	if (flag) goto addr8_rel;
}
:bt A^"."imm4_6, addr8_rel is op=0x31; imm7=0 & imm4_6 & immlo=3; addr8_rel & A {
	local flag:1 = (A & (1 << imm4_6)) != 0;
	if (flag) goto addr8_rel;
}
:bt PSW^"."imm4_6, addr8_rel is op=0x31; imm7=1 & imm4_6 & immlo=2; op=0xFA; addr8_rel & PSW { 
	local flag:1 = (PSW & (1 << imm4_6)) != 0;
	if (flag) goto addr8_rel;
}
:bt hl_ind"."imm4_6, addr8_rel is op=0x31; imm7=1 & imm4_6 & immlo=3; addr8_rel & hl_ind { 
	local flag:1 = ((*[ram]:1 hl_ind) & (1 << imm4_6)) != 0;
	if (flag) goto addr8_rel;
}
:bt es_hl_ind"."imm4_6, addr8_rel is op=0x11; op=0x31; imm7=1 & imm4_6 & immlo=3; addr8_rel & es_hl_ind { 
	local flag:1 = ((*[ram]:1 es_hl_ind) & (1 << imm4_6)) != 0;
	if (flag) goto addr8_rel;
}

#bf
:bf saddr"."imm4_6, addr8_rel is op=0x31; imm7=0 & imm4_6 & immlo=4; saddr; addr8_rel { 
	local flag:1 = ((*[ram]:1 saddr) & (1 << imm4_6)) == 0;
	if (flag) goto addr8_rel;
}
:bf sfr"."imm4_6, addr8_rel is op=0x31; imm7=1 & imm4_6 & immlo=4; sfr; addr8_rel { 
	local flag:1 = ((*[ram]:1 sfr) & (1 << imm4_6)) == 0;
	if (flag) goto addr8_rel;
}
:bf A^"."imm4_6, addr8_rel is op=0x31; imm7=0 & imm4_6 & immlo=5; addr8_rel & A { 
	local flag:1 = (A & (1 << imm4_6)) == 0;
	if (flag) goto addr8_rel;
}
:bf PSW^"."imm4_6, addr8_rel is op=0x31; imm7=1 & imm4_6 & immlo=4; op=0xFA; addr8_rel & PSW { 
	local flag:1 = (PSW & (1 << imm4_6)) == 0;
	if (flag) goto addr8_rel;
}
:bf hl_ind"."imm4_6, addr8_rel is op=0x31; imm7=1 & imm4_6 & immlo=5; addr8_rel & hl_ind { 
	local flag:1 = ((*[ram]:1 hl_ind) & (1 << imm4_6)) == 0;
	if (flag) goto addr8_rel;
}
:bf es_hl_ind"."imm4_6, addr8_rel is op=0x11; op=0x31; imm7=1 & imm4_6 & immlo=5; addr8_rel & es_hl_ind { 
	local flag:1 = ((*[ram]:1 es_hl_ind) & (1 << imm4_6)) == 0;
	if (flag) goto addr8_rel;
}


# btclr
macro _btclr_mem(addr, off, dest) {
	local og:1 =  *[ram]:1 addr;
	local flag:1 = (og & (1 << off)) != 0;
	
	if(flag == 0) goto <end>;
		*[ram]:1 addr = og & (~(1 << off));
		goto dest;
	<end>
}
macro _btclr(src, off, dest) {
	local flag:1 = (src & (1 << off)) != 0;
	
	if(flag == 0) goto <end>;
		src = src & (~(1 << off));
		goto dest;
	<end>
}

:btclr saddr"."imm4_6  addr8_rel is op=0x31; imm7=0 & imm4_6 & immlo=0 ; saddr ; addr8_rel { _btclr_mem(saddr, imm4_6, addr8_rel); }
:btclr sfr"."imm4_6  addr8_rel is op=0x31; imm7=1 & imm4_6 & immlo=0 ; sfr ; addr8_rel { _btclr_mem(sfr, imm4_6, addr8_rel); }
:btclr A^"."imm4_6  addr8_rel is op=0x31; imm7=0 & imm4_6 & immlo=1 ; addr8_rel & A { _btclr(A, imm4_6, addr8_rel); }
:btclr PSW^"."imm4_6  addr8_rel is op=0x31; imm7=1 & imm4_6 & immlo=0; op=0xFA ; addr8_rel & PSW { _btclr(PSW, imm4_6, addr8_rel); }
:btclr hl_ind"."imm4_6  addr8_rel is op=0x31; imm7=1 & imm4_6 & immlo=1; addr8_rel & hl_ind { _btclr_mem(hl_ind, imm4_6, addr8_rel); }
:btclr es_hl_ind"."imm4_6  addr8_rel is op=0x11; op=0x31; imm7=1 & imm4_6 & immlo=1; addr8_rel & es_hl_ind { _btclr_mem(es_hl_ind, imm4_6, addr8_rel); }

:skc is op=0x61;op=0xC8 { 
	if(CY != 1) goto <next>;
	delayslot(1); # Include instruction after skc
	<next>
	goto inst_next; # Goto instruction after the next one
}
:sknc is op=0x61;op=0xD8 { 
	if(CY != 0) goto <next>;
	delayslot(1);
	<next>
	goto inst_next;
}
:skz is op=0x61;op=0xE8 { 
	if(Z != 1) goto <next>;
	delayslot(1);
	<next>
	goto inst_next;
}
:sknz is op=0x61;op=0xF8 { 
	if(Z != 0) goto <next>;
	delayslot(1);
	<next>
	goto inst_next;
}
:skh is op=0x61;op=0xE3 { 
	if(Z == 0 || CY == 0) goto <next>;
	delayslot(1);
	<next>
	goto inst_next;
}
:sknh is op=0x61;op=0xF3 { 
	if(Z == 1 || CY == 1) goto <next>;
	delayslot(1);
	<next>
	goto inst_next;
}

define pcodeop switch_bank;
:"SEL RB0" is op=0x61;op=0xCF [current_bank = 0; globalset(inst_next,current_bank);] { switch_bank(0:1); }
:"SEL RB1" is op=0x61;op=0xDF [current_bank = 1; globalset(inst_next,current_bank);] { switch_bank(1:1); }
:"SEL RB2" is op=0x61;op=0xEF [current_bank = 2; globalset(inst_next,current_bank);] { switch_bank(2:1); }
:"SEL RB3" is op=0x61;op=0xFF [current_bank = 3; globalset(inst_next,current_bank);] { switch_bank(3:1); }

define pcodeop nop;
:nop is op=0x00 { nop(); }

define pcodeop ei;
:EI is op=0x71;op=0x7A;op=0xFA { ei(); }

define pcodeop di;
:DI is op=0x71;op=0x7B;op=0xFA { di(); }

define pcodeop halt;
:halt is op=0x61;op=0xED { halt(); }

define pcodeop stop;
:stop is op=0x61;op=0xFD { stop(); }

# PREFIX is a address extension prefix, not a instruction on its own
